{
    "name": "rivalex/laravel-breadcrumbs",
    "description": "A simple Laravel-style way to create breadcrumbs with Font Awesome support.",
    "keywords": [
        "laravel"
    ],
    "homepage": "https://github.com/rivalex/laravel-breadcrumbs",
    "authors": [
        {
            "name": "Rivalex",
            "email": "info@rivalex.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.71|^13.40",
        "spatie/error-solutions": "^1.0|^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "spatie/phpunit-snapshot-assertions": "^5.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Rivalex\\Breadcrumbs\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/",
            "BreadcrumbsTests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rivalex\\Breadcrumbs\\BreadcrumbsServiceProvider"
            ],
            "aliases": {
                "Breadcrumbs": "Rivalex\\Breadcrumbs\\Facades\\Breadcrumbs"
            }
        }
    }
}
